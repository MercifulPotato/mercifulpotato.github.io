@inherits LayoutComponentBase

<div class="page">
    <header class="top-bar">
        <div class="container top-bar-inner">
            <a class="brand" href="/">
                <strong>Merciful Potato</strong> Magazine
            </a>
            <NavMenu />
        </div>
    </header>

    <main class="container main-content">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="exception">
                <section class="page-error" role="alert">
                    <h1>This page ran into a problem</h1>
                    <p>
                        Something went wrong while showing this page. The rest of the site still works,
                        and the error has been logged to the browser console.
                    </p>
                    <details class="page-error-details">
                        <summary>Technical details</summary>
                        <pre>@exception.GetType().FullName: @exception.Message</pre>
                    </details>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="Recover">Try again</button>
                        <a class="btn btn-outline btn-sm" href="">Go to the home page</a>
                    </div>
                </section>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>
                &copy; @DateTime.UtcNow.Year Merciful Potato Magazine &mdash; Built with
                <a href="https://dotnet.microsoft.com/apps/aspnet/web-apps/blazor" target="_blank"
                   rel="noopener noreferrer">Blazor WebAssembly</a>
                on .NET 11.
            </p>
            <p>
                <a href="/feed.xml">RSS Feed</a>
                &middot;
                <a href="https://github.com/mercifulpotato/mercifulpotato.github.io"
                   target="_blank" rel="noopener noreferrer">Source on GitHub</a>
            </p>
        </div>
    </footer>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Recover() => _errorBoundary?.Recover();
}
