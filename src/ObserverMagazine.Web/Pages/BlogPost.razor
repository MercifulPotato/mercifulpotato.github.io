@page "/blog/{Slug}"
@inject IBlogService BlogService
@inject ILogger<BlogPost> Logger
@inject IAnalyticsService Analytics
@inject IJSRuntime Js

<PageTitle>@PageTitleText — Merciful Potato Magazine</PageTitle>

@switch (_view)
{
    case BlogPostLoading:
        <p><em>Loading...</em></p>
        break;

    case BlogPostMissing:
        <h1>Post Not Found</h1>
        <p>Sorry, we couldn't find that post. <a href="blog">Back to Blog</a></p>
        break;

    case BlogPostLoaded(var metadata, var html, var author):
        <article class="blog-post">
            <header>
                <h1>@metadata.Title</h1>
                <div class="blog-meta">
                    <time datetime="@metadata.Date.ToString("yyyy-MM-dd")">
                        @metadata.Date.ToString("MMMM d, yyyy")
                    </time>
                    @if (metadata.Updated.HasValue)
                    {
                        <span> · Updated @metadata.Updated.Value.ToString("MMMM d, yyyy")</span>
                    }
                    @if (!string.IsNullOrEmpty(metadata.AuthorName))
                    {
                        <span> · @metadata.AuthorName</span>
                    }
                    @if (metadata.ReadingTimeMinutes > 0)
                    {
                        <span> · @metadata.ReadingTimeMinutes min read</span>
                    }
                    @if (_viewCount.HasValue)
                    {
                        <span> · @_viewCount views</span>
                    }
                </div>
                @if (metadata.Tags is { Length: > 0 })
                {
                    <div class="tag-list">
                        @foreach (var tag in metadata.Tags)
                        {
                            <a class="tag" href="blog/tag/@Uri.EscapeDataString(tag)">@tag</a>
                        }
                    </div>
                }
            </header>

            <BlogTtsPlayer Slug="@Slug" />

            <div class="blog-content">
                @((MarkupString)html)
            </div>

            <Reactions Slug="@Slug" />

            <AuthorCard Author="author" />

            <footer class="blog-post-footer">
                <a href="blog">&larr; Back to Blog</a>
            </footer>
        </article>
        break;
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private BlogPostView _view = new BlogPostLoading();
    private int? _viewCount;

    private string PageTitleText => _view is BlogPostLoaded loaded ? loaded.Metadata.Title : "Post";

    protected override async Task OnParametersSetAsync()
    {
        _view = new BlogPostLoading();
        _viewCount = null;
        Logger.LogInformation("Loading blog post: {Slug}", Slug);

        _view = await LoadAsync();

        if (_view is BlogPostLoaded loaded)
        {
            await Analytics.TrackPageViewAsync("BlogPost", $"{loaded.Metadata.Title} ({Slug})");
            await Analytics.IncrementViewAsync(Slug);
            _viewCount = await Analytics.GetViewCountAsync(Slug);
        }
    }

    private async Task<BlogPostView> LoadAsync()
    {
        try
        {
            var metadata = await BlogService.GetPostMetadataAsync(Slug);
            if (metadata is null)
            {
                return new BlogPostMissing();
            }

            var html = PostProcessHtml(await BlogService.GetPostHtmlAsync(Slug));
            var author = string.IsNullOrEmpty(metadata.Author)
                ? null
                : await BlogService.GetAuthorAsync(metadata.Author);

            return new BlogPostLoaded(metadata, html, author);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load post {Slug}", Slug);
            return new BlogPostMissing();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_view is not BlogPostLoaded)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("observerHighlight.highlightAll");
            await Js.InvokeVoidAsync("observerCodeScroll.init");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Post-render enhancement failed for {Slug}", Slug);
        }
    }

    private static string PostProcessHtml(string html) => html
        .Replace(
            "<pre",
            "<div class=\"code-block-wrap\"><span class=\"code-scroll-hint\" aria-hidden=\"true\">scroll \u2192</span><pre")
        .Replace("</pre>", "</pre></div>")
        .Replace("<table", "<div class=\"table-scroll-wrap\"><table")
        .Replace("</table>", "</table></div>");
}
